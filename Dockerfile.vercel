FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    TMPDIR=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    PADDLE_PDX_CACHE_HOME=/tmp/paddlex \
    PADDLE_PDX_MODEL_SOURCE=bos \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

WORKDIR /app

# Mesmo princípio usado na API de moedas já funcional na Vercel:
# dependências Linux necessárias para OpenCV/Paddle em ambiente container.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libglib2.0-0 \
    libgl1 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./

RUN python -m pip install --upgrade pip \
    && pip install -r requirements.txt

COPY app_main.py ./
COPY ocr_engine.py ./

EXPOSE 80

CMD ["sh", "-c", "uvicorn app_main:app --host 0.0.0.0 --port ${PORT:-80}"]
